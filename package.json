{
  "name": "bayan",
  "version": "0.3.0",
  "private": true,
  "description": "Al-Qur’an, hadis, dan perpustakaan PDF pribadi, sepenuhnya offline.",
  "author": "Bayan",
  "type": "module",
  "main": "src/main/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "start": "electron .",
    "build": "npm run validate && vite build",
    "test": "node --test tests/*.test.js",
    "validate": "node scripts/validate-data.js && node scripts/validate-hadith.js",
    "pack": "npm run build && electron-builder --dir",
    "dist:mac": "npm run build && electron-builder --mac dmg",
    "dist:win": "npm run build && electron-builder --win nsis --x64",
    "test:desktop": "node scripts/smoke-electron.js",
    "test:features": "node scripts/smoke-features.js",
    "test:upgrade": "node scripts/smoke-upgrade.js"
  },
  "build": {
    "appId": "id.sisipayat.app",
    "productName": "Bayan",
    "asar": true,
    "files": [
      "dist/**/*",
      "src/main/**/*",
      "src/core/**/*",
      "data/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "identity": null,
      "icon": "assets/bayan-logo.png"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/bayan-logo.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false
    },
    "extraResources": [
      {
        "from": "assets/fonts",
        "to": "fonts"
      },
      {
        "from": "data/NOTICE.md",
        "to": "NOTICE-data.md"
      }
    ],
    "artifactName": "Bayan-${version}-${os}-${arch}.${ext}"
  },
  "dependencies": {
    "lucide-react": "^1.77.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "vite": "^8.3.8"
  }
}
